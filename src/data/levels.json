        "npcAudioPath": "/audio/level2/p1_npc.mp3",

        "backgroundImage": "/backgrounds/playground.png",

        "npcSprite": "/characters/friend.png",
        "playerSprite": "/characters/player.png",

        "hint": {
          "enabled": false,
          "type": "placeholder",
          "text": "",
          "cost": 0
        },

        "choices": [
          {
            "id": "p1a",

            "choiceText": "आम्, अहं कन्दुकम् आनयामि।",
            "choiceTranslation": "Yes, I am bringing a ball.",

            "choiceAudioPath": "/audio/level2/p1a.mp3",

            "isCorrect": true,

            "nextNodeId": "p2a"
          },

          {
            "id": "p1b",

            "choiceText": "क्षम्यताम्, अहं श्वः आगमिष्यामि।",
            "choiceTranslation": "Sorry, I will come tomorrow.",

            "choiceAudioPath": "/audio/level2/p1b.mp3",

            "isCorrect": false,

            "feedback": "Your friend invited you this evening, but this reply moves the plan to tomorrow.",

            "nextNodeId": "p2b"
          }
        ]
      },

      "p2a": {
        "id": "p2a",

        "speaker": "Friend",

        "npcText": "अस्तु! क्रीडाङ्गणम् आगच्छतु। अन्ये अपि आगच्छन्ति।",
        "npcTranslation": "Great! Come to the field. Others are coming too.",

        "npcAudioPath": "/audio/level2/p2a_npc.mp3",

        "backgroundImage": "/backgrounds/playground.png",

        "npcSprite": "/characters/friend.png",
        "playerSprite": "/characters/player.png",

        "hint": {
          "enabled": false,
          "type": "placeholder",
          "text": "",
          "cost": 0
        },

        "choices": [
          {
            "id": "p2a1",

            "choiceText": "मम मित्रम् अपि आनयामि।",
            "choiceTranslation": "I will bring my friend too.",

            "choiceAudioPath": "/audio/level2/p2a1.mp3",

            "isCorrect": true,

            "nextNodeId": "END"
          },

          {
            "id": "p2a2",

            "choiceText": "अहं विद्यालयं गमिष्यामि।",
            "choiceTranslation": "I will go to school.",

            "choiceAudioPath": "/audio/level2/p2a2.mp3",

            "isCorrect": false,

            "feedback": "Your friend asked about meeting at the field, so respond to the plan instead of changing the topic.",

            "nextNodeId": "END"
          }
        ]
      },

      "p2b": {
        "id": "p2b",

        "speaker": "Friend",

        "npcText": "अस्तु, श्वः मेलावः।",
        "npcTranslation": "Okay, let's meet tomorrow.",

        "npcAudioPath": "/audio/level2/p2b_npc.mp3",

        "backgroundImage": "/backgrounds/playground.png",

        "npcSprite": "/characters/friend.png",
        "playerSprite": "/characters/player.png",

        "hint": {
          "enabled": false,
          "type": "placeholder",
          "text": "",
          "cost": 0
        },

        "choices": [
          {
            "id": "p2b1",

            "choiceText": "आम्, श्वः निश्चितम् आगच्छामि।",
            "choiceTranslation": "Yes, I will definitely come tomorrow.",

            "choiceAudioPath": "/audio/level2/p2b1.mp3",

            "isCorrect": true,

            "nextNodeId": "END"
          },

          {
            "id": "p2b2",

            "choiceText": "अहं अद्य क्रीडितुम् इच्छामि।",
            "choiceTranslation": "I want to play today.",

            "choiceAudioPath": "/audio/level2/p2b2.mp3",

            "isCorrect": false,

            "feedback": "You agreed to meet tomorrow, so confirm that plan rather than return to playing today.",

            "nextNodeId": "END"
          }
        ]
      }
    }
  },

